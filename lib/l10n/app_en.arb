  "settingsHelpTooltip": "About this setting",
  "@settingsHelpTooltip": {
    "description": "Tooltip on the help (?) icon next to a setting"
  },
  "settingsHelpShowSciNames": "Shows the scientific names in gray under the common names. Handy if you use a bird book that lists the Latin names.",
  "@settingsHelpShowSciNames": {
    "description": "Help text for the show scientific names setting"
  },
  "settingsHelpGain": "Multiplies the microphone signal in the app. Use values above 1.0 only for very quiet recordings — high gain amplifies noise too and can cause clipping. Most built-in mics work best at 1.0.",
  "@settingsHelpGain": {
    "description": "Help text for gain setting"
  },
  "settingsHelpHighPassFilter": "Removes low-frequency content (wind, traffic, handling noise) before inference. Most species vocalize above 1 kHz, so a 100–200 Hz cut-off is usually safe and improves detection in noisy conditions.",
  "@settingsHelpHighPassFilter": {
    "description": "Help text for high-pass filter setting"
  },
  "settingsHelpWindowDuration": "How many seconds of audio BirdNET analyzes at once. Shorter windows react faster and give finer time resolution; longer windows average more context per pass for steadier scores at the cost of slower reaction time.",
  "@settingsHelpWindowDuration": {
    "description": "Help text for analysis window duration setting"
  },
  "settingsHelpConfidenceThreshold": "Detections below this score are hidden. Default is 35%. Lower values surface more uncertain detections (good for rare species or quiet recordings); higher values reduce false positives but may miss faint or distant calls.",
  "@settingsHelpConfidenceThreshold": {
    "description": "Help text for confidence threshold setting"
  },
  "settingsHelpInferenceRate": "How often BirdNET runs inference per second. Higher rates catch brief calls but use more battery and CPU; lower rates are gentler on the device but may miss short vocalizations.",
  "@settingsHelpInferenceRate": {
    "description": "Help text for inference rate setting"
  },
  "settingsHelpShowAllDetectedSpecies": "Decides which birds stay in the list while you listen. Normally you only see the ones singing right now. When enabled, all birds from this session stay visible, even once they have gone quiet.",
  "@settingsHelpShowAllDetectedSpecies": {
    "description": "Help text for the Live Mode and Point Count species-list display setting"
  },
  "settingsHelpDetectedSpeciesSortNewest": "Currently vocalizing species appear first, sorted by their current confidence, then retained species follow by their most recent detection time.",
  "@settingsHelpDetectedSpeciesSortNewest": {
    "description": "Help text for newest-first all-species sorting"
  },
  "settingsHelpDetectedSpeciesSortConfidence": "Species are sorted by the highest confidence each species reached during the session, from highest to lowest. Retained inactive species stay in the list without confidence visuals.",
  "@settingsHelpDetectedSpeciesSortConfidence": {
    "description": "Help text for confidence all-species sorting"
  },
  "settingsHelpDetectedSpeciesSortAlphabetical": "Species are sorted alphabetically by common name. Confidence visuals still appear only while the species is currently vocalizing.",
  "@settingsHelpDetectedSpeciesSortAlphabetical": {
    "description": "Help text for alphabetical all-species sorting"
  },
  "settingsHelpDetectedSpeciesSortOccurrences": "Species with more detections appear first. The count chip after the common name shows the number used for this sorting.",
  "@settingsHelpDetectedSpeciesSortOccurrences": {
    "description": "Help text for occurrence-count all-species sorting"
  },
  "settingsHelpFftSize": "FFT window size used to compute the spectrogram – the picture of sound. Larger values give finer frequency but coarser time resolution; smaller values show short calls more sharply but smear the frequencies. 1024–2048 works well for most species.",
  "@settingsHelpFftSize": {
    "description": "Help text for FFT size setting"
  },
  "settingsHelpColorMap": "Color palette the spectrogram – the picture of sound – uses to show intensity. Turbo is a modern, Jet-like rainbow palette; Viridis, Magma, Plasma and Cividis are perceptually uniform palettes; Grayscale is print-friendly.",
  "@settingsHelpColorMap": {
    "description": "Help text for spectrogram color map setting"
  },
  "settingsHelpSpectrogramDuration": "How many seconds of audio fit on screen at once. Shorter durations give more detail per call; longer durations show temporal patterns and let you compare detections.",
  "@settingsHelpSpectrogramDuration": {
    "description": "Help text for spectrogram duration setting"
  },
  "settingsHelpFrequencyRange": "Upper limit of the vertical axis in the spectrogram, the picture of sound. Lower it to focus on low-frequency sounds (owls, grouse), or raise it to see high calls and insect sounds. More than 16 kHz is not possible because the app records at 32 kHz.",
  "@settingsHelpFrequencyRange": {
    "description": "Help text for spectrogram frequency range setting"
  },
  "settingsHelpLogAmplitude": "Applies a logarithmic scale to the intensity in the spectrogram – the picture of sound. Makes quiet calls more visible but also shows more background noise. Helpful for distant or quiet species.",
  "@settingsHelpLogAmplitude": {
    "description": "Help text for log amplitude setting"
  },
  "settingsHelpSpectrogramQuality": "Controls GPU filtering when drawing the live spectrogram, the picture of sound. “High” looks cleanest and is recommended for modern devices. On older devices, choose “Medium” or “Low” if you see dropped frames or higher battery use.",
  "@settingsHelpSpectrogramQuality": {
    "description": "Help text for spectrogram quality setting"
  },
  "settingsHelpRecordingMode": "Whether and how audio is saved to disk. 'Full' keeps everything (large files); 'Detections only' saves short clips around each detection; 'Off' analyzes in real time without writing audio.",
  "@settingsHelpRecordingMode": {
    "description": "Help text for recording mode setting"
  },
  "settingsHelpRecordingFormat": "Container format for saved audio. WAV is uncompressed and universally supported; FLAC is lossless but ~50% smaller and supported by most analysis software.",
  "@settingsHelpRecordingFormat": {
    "description": "Help text for recording format setting"
  },
  "settingsHelpUseGps": "Uses your phone’s GPS for your location. When disabled, the app uses the location you set yourself – handy when GPS is poor.",
  "@settingsHelpUseGps": {
    "description": "Help text for use GPS setting"
  },
  "settingsHelpSpeciesFilter": "Restrict detections by geographic likelihood using the on-device location model. 'Location filter' hides species below the threshold. 'Adaptive location filter' asks for more confidence the less common a species is here — abundant species are never filtered, uncommon ones need a high score — using the same abundance tiers as the Explore screen. 'Location weighting' multiplies detection scores by the location prior.",
  "@settingsHelpSpeciesFilter": {
    "description": "Help text for species filter setting"
  },
  "settingsHelpGeoThreshold": "Minimum geographic-prior score for a species to pass the location filter. Lower values are more permissive (good for rare or migrating species); higher values stay strictly within typical ranges.",
  "@settingsHelpGeoThreshold": {
    "description": "Help text for geo threshold setting"
  },
  "settingsHelpIncludeAudioFiles": "When enabled, the backup file also contains the saved recordings; when restoring, they are put back on the new device. This makes the file much larger – a year of recordings can take up several hundred megabytes.",
  "@settingsHelpIncludeAudioFiles": {
    "description": "Help text for include audio files setting"
  },

