  "onboardingWelcomeTitle": "Welcome to Smartfinch",
  "@onboardingWelcomeTitle": {
    "description": "Onboarding welcome screen title"
  },
  "onboardingWelcomeBody": "AI-powered bioacoustic monitoring for field researchers and citizen scientists. Runs entirely on-device — no internet required.",
  "@onboardingWelcomeBody": {
    "description": "Onboarding welcome screen body text"
  },
  "onboardingHowItWorksTitle": "How It Works",
  "@onboardingHowItWorksTitle": {
    "description": "Onboarding how it works screen title"
  },
  "onboardingHowItWorksBody": "The app listens through the microphone and recognizes from the song which bird is singing. An AI does this right on your phone – so it works without the internet, and the app never uploads recordings.",
  "@onboardingHowItWorksBody": {
    "description": "Onboarding how it works body text"
  },
  "onboardingFeaturesBody": "The birds you find earn you stars. New species go into your collection, and in the journal you can listen to every day again.",
  "@onboardingFeaturesBody": {
    "description": "Onboarding features screen body text"
  },
  "onboardingPermissionsTitle": "Permissions",
  "@onboardingPermissionsTitle": {
    "description": "Onboarding permissions screen title"
  },
  "onboardingPermissionsBody": "The app needs the microphone to hear birds. It needs your location to know which birds live in your area – instead of GPS, you can also pick it on the map. You can turn both off again at any time in your phone’s settings.",
  "@onboardingPermissionsBody": {
    "description": "Onboarding permissions screen body text"
  },
  "onboardingTermsTitle": "Acceptable Use & Privacy",
  "@onboardingTermsTitle": {
    "description": "Onboarding acceptable use and privacy screen title"
  },
  "onboardingTermsBody": "The app can be wrong: what it recognizes is the AI’s guess, not a sure identification. Recordings stay on your device and are never uploaded. The app only goes online if you allow it – for map images, for place names and for the weather, each one separately. The app and its AI must not be used to harm animals, nature or people. Below you can read the full rules and the privacy policy.",
